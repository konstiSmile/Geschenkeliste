{
  "id": "/Geschenkeliste/",
  "name": "Geschenkeliste",
  "short_name": "Geschenke",
  "description": "Wunschlisten für Familie und Freunde. Reservierungen bleiben geheim, Wichteln inklusive.",
  "lang": "de",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone"],
  "background_color": "#f5f2ec",
  "theme_color": "#f5f2ec",
  "categories": ["lifestyle", "shopping"],
  "launch_handler": { "client_mode": "navigate-existing" },
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Neuer Wunsch",
      "short_name": "Neuer Wunsch",
      "url": "./#/w/neu",
      "icons": [
        { "src": "icons/shortcut-neu.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
        { "src": "icons/shortcut-neu.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" }
      ]
    },
    {
      "name": "Meine Wunschliste",
      "short_name": "Wunschliste",
      "url": "./#/liste",
      "icons": [
        { "src": "icons/shortcut-liste.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
        { "src": "icons/shortcut-liste.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" }
      ]
    },
    {
      "name": "Gruppen",
      "short_name": "Gruppen",
      "url": "./#/gruppen",
      "icons": [
        { "src": "icons/shortcut-gruppen.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
        { "src": "icons/shortcut-gruppen.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" }
      ]
    }
  ],
  "screenshots": [
    { "src": "screenshots/start.png", "sizes": "780x1688", "type": "image/png", "form_factor": "narrow", "label": "Start mit Countdown und Besorgungen" },
    { "src": "screenshots/person.png", "sizes": "780x1688", "type": "image/png", "form_factor": "narrow", "label": "Wunschliste einer Person mit Filter" },
    { "src": "screenshots/wichteln.png", "sizes": "780x1688", "type": "image/png", "form_factor": "narrow", "label": "Wichteln" }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
